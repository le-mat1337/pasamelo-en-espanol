# Copiar a backend/.env para desarrollo (no se commitea). En Vercel, cargarlas en el proyecto.
# Las PUBLIC_* las lee el frontend al compilar: van en el proyecto de Vercel, no en el backend.

# --- Obligatorias en producción ---

# Groq: transcripción (whisper-large-v3-turbo) y traducción (gpt-oss-120b, cambiable con PES_MODELO_GROQ). Gratis: https://console.groq.com
GROQ_API_KEY=

# Cloudflare Turnstile (gratis). La secreta va al backend; la de sitio, al frontend.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Hostnames que Turnstile puede devolver como válidos (coma), en punycode
PES_HOSTS=xn--pasameloenespaol-kub.com,www.xn--pasameloenespaol-kub.com

# Cron de limpieza: Vercel manda "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Sal para hashear IPs: string largo y aleatorio (openssl rand -hex 32)
PES_SAL=

# Upstash Redis: lo carga Vercel al conectar la base desde el Marketplace
# UPSTASH_REDIS_REST_URL=  UPSTASH_REDIS_REST_TOKEN=  (o KV_REST_API_URL / KV_REST_API_TOKEN)

# Videos: Cloudflare R2 (recomendado, transferencia gratis) o Vercel Blob. Si están las R2_*, se usa R2.
# R2: bucket privado + token "Object Read & Write" solo para ese bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pes-videos
# Blob: lo carga Vercel al conectar un store público
# BLOB_STORE_ID=  (o BLOB_READ_WRITE_TOKEN para desarrollo)

# --- Traductor ---

# groq (default, gratis) | anthropic (Claude Haiku 5.5, ~USD 0,0002 por video)
TRADUCTOR=groq
ANTHROPIC_API_KEY=

# --- Texto escrito sobre el video ---
# Si el video es una canción o no habla nadie, se lee el texto de encima con el modelo de visión de Groq
# y se traduce el que está en inglés. false lo apaga sin tocar código.
PES_TEXTO=true
PES_MODELO_VISION=qwen/qwen3.8-27b
# Cuadros por video (uno cada 2 s o más; 9 por imagen si es vertical, 6 si es horizontal; hasta 3
# imágenes, y Groq cuenta 2048 tokens por imagen). Máximo 27.
PES_TEXTO_CUADROS=18

# --- Límites (estos son los defaults, pensados para el plan Hobby de Vercel) ---
# Hobby trae 4 h de CPU por mes: ~80 videos nuevos por día entran con margen. En Pro se pueden subir.

PES_MAX_POR_IP_DIA=3
PES_MAX_JOBS_DIA=80
PES_MAX_JOBS_HORA=15
PES_MAX_DURACION_S=180
PES_MAX_MB=60
PES_TTL_HORAS=24
PES_VIDA_MAX_HORAS=72
# Los mismos límites para mostrar en la home (frontend)
PUBLIC_MAX_POR_IP_DIA=3
PUBLIC_MAX_DURACION_S=180

# Interruptor: true pone la página "en pausa" sin tocar código
PES_PAUSADO=false

# --- Frontend (opcionales) ---

PUBLIC_REPO_URL=https://github.com/le-mat1337/pasamelo-en-espanol
PUBLIC_AUTOR_URL=https://www.instagram.com/le.mat1337/

# --- Solo desarrollo ---

# Subtítulos de prueba sin Groq (se ignora fuera de desarrollo)
PES_DEMO=false
