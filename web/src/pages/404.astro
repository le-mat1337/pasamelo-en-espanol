---
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
---

<Base title="Acá no hay nada · pasámelo en español" indexar={false}>
  <Marca />
  <section class="estado">
    <div class="calavera" aria-hidden="true">💀</div>
    <h1>Acá no hay nada, capo</h1>
    <p class="bajada">Si te pasaron un link, puede que ya se haya borrado: duran 24 horas. Pedí que te lo pasen de nuevo.</p>
    <a class="cta" href="/">Traducir un video</a>
  </section>
</Base>
